// ScentVault V1 — initial data model for Prisma ORM 7 + PostgreSQL.
// Configure DATABASE_URL in apps/api/prisma.config.ts, not here.
// For v1, one physical store; do not add merchant_id without updating authorization.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Concentration {
  EDT
  EDP
  PARFUM
  EXTRAIT
  COLOGNE
  OTHER
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum NoteLayer {
  TOP
  HEART
  BASE
}

enum VariantKind {
  FULL_BOTTLE
  DECANT
}

enum LotKind {
  SEALED_BOTTLE
  DECANT_SOURCE
}

enum StockReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum InventoryMovementType {
  RESTOCK
  SALE
  CUSTOMER_RETURN
  ADJUSTMENT
  DECANT_TRANSFER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  SANDBOX
}

enum ShipmentStatus {
  NOT_SHIPPED
  PACKED
  DISPATCHED
  DELIVERED
  RETURNED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(120)
  email           String       @unique @db.VarChar(254)
  passwordHash    String
  phone           String?      @db.VarChar(25)
  role            Role         @default(CUSTOMER)
  isActive        Boolean      @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sessions        AuthSession[]
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]
  inventoryMoves  InventoryMovement[] @relation("InventoryActor")
  auditLogs       AuditLog[]          @relation("AuditActor")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String?  @db.VarChar(60)
  recipient  String   @db.VarChar(120)
  phone      String   @db.VarChar(25)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  area       String?  @db.VarChar(100)
  city       String   @db.VarChar(100)
  postalCode String?  @db.VarChar(20)
  country    String   @default("Bangladesh") @db.VarChar(100)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(120)
  slug        String      @unique @db.VarChar(130)
  description String?
  logoUrl     String?
  fragrances  Fragrance[]
}

model Fragrance {
  id             String         @id @default(uuid()) @db.Uuid
  brandId        String         @db.Uuid
  name           String         @db.VarChar(180)
  slug           String         @unique @db.VarChar(220)
  concentration  Concentration
  description    String
  family         String?        @db.VarChar(80)
  status         CatalogStatus  @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  brand          Brand          @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  notes          FragranceNote[]
  variants       ProductVariant[]
  inventoryLots  InventoryLot[]
  reviews        Review[]
  wishlists      WishlistItem[]

  @@index([brandId, status])
  @@index([name])
}

model ProductImage {
  id          String    @id @default(uuid()) @db.Uuid
  fragranceId String    @db.Uuid
  url         String
  alt         String?   @db.VarChar(200)
  position    Int       @default(0)
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([fragranceId, position])
}

model ScentNote {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique @db.VarChar(100)
  fragrances  FragranceNote[]
}

model FragranceNote {
  fragranceId String    @db.Uuid
  noteId      String    @db.Uuid
  layer       NoteLayer
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)
  note        ScentNote @relation(fields: [noteId], references: [id])

  @@id([fragranceId, noteId, layer])
}

model ProductVariant {
  id              String      @id @default(uuid()) @db.Uuid
  fragranceId     String      @db.Uuid
  sku             String      @unique @db.VarChar(80)
  kind            VariantKind
  volumeMl        Int
  priceMinor      Int
  compareAtMinor  Int?
  isActive        Boolean     @default(true)
  fragrance       Fragrance   @relation(fields: [fragranceId], references: [id])
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([fragranceId, kind, volumeMl])
  @@index([fragranceId, isActive])
}

model InventoryLot {
  id            String          @id @default(uuid()) @db.Uuid
  fragranceId   String          @db.Uuid
  kind          LotKind
  batchCode     String?         @db.VarChar(120)
  bottleSizeMl  Int
  unitsOnHand   Int             @default(0)
  remainingMl   Int             @default(0)
  costMinor     Int?
  isActive      Boolean         @default(true)
  acquiredAt    DateTime        @default(now())
  fragrance     Fragrance       @relation(fields: [fragranceId], references: [id])
  reservations  StockReservation[]
  movements     InventoryMovement[]

  @@index([fragranceId, kind, bottleSizeMl])
}

model InventoryMovement {
  id           String    @id @default(uuid()) @db.Uuid
  lotId        String    @db.Uuid
  orderItemId  String?   @db.Uuid
  actorId      String?   @db.Uuid
  type         InventoryMovementType
  deltaUnits   Int       @default(0)
  deltaMl      Int       @default(0)
  reason       String?
  createdAt    DateTime  @default(now())
  lot          InventoryLot @relation(fields: [lotId], references: [id])
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])
  actor        User?        @relation("InventoryActor", fields: [actorId], references: [id])

  @@index([lotId, createdAt])
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @db.Uuid
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id         String         @id @default(uuid()) @db.Uuid
  cartId     String         @db.Uuid
  variantId  String         @db.Uuid
  quantity   Int
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model WishlistItem {
  userId       String    @db.Uuid
  fragranceId  String    @db.Uuid
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragrance    Fragrance @relation(fields: [fragranceId], references: [id])

  @@id([userId, fragranceId])
}

model Coupon {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique @db.VarChar(60)
  type              DiscountType
  value             Int
  minSubtotalMinor  Int          @default(0)
  maxDiscountMinor  Int?
  usageLimit        Int?
  usedCount         Int          @default(0)
  expiresAt         DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  orders            Order[]
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderNo            String      @unique @db.VarChar(30)
  userId             String      @db.Uuid
  couponId           String?     @db.Uuid
  status             OrderStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)
  subtotalMinor      Int
  discountMinor      Int         @default(0)
  deliveryMinor      Int         @default(0)
  totalMinor         Int
  recipient          String      @db.VarChar(120)
  deliveryPhone      String      @db.VarChar(25)
  deliveryLine1      String      @db.VarChar(200)
  deliveryLine2      String?     @db.VarChar(200)
  deliveryArea       String?     @db.VarChar(100)
  deliveryCity       String      @db.VarChar(100)
  deliveryPostalCode String?     @db.VarChar(20)
  deliveryCountry    String      @default("Bangladesh") @db.VarChar(100)
  customerNote       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id])
  coupon             Coupon?     @relation(fields: [couponId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  shipment           Shipment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  variantId     String?     @db.Uuid
  fragranceName String      @db.VarChar(250)
  variantSku    String      @db.VarChar(80)
  kind          VariantKind
  volumeMl      Int
  unitPriceMinor Int
  quantity      Int
  lineTotalMinor Int
  order          Order       @relation(fields: [orderId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reservations   StockReservation[]
  movements      InventoryMovement[]

  @@index([orderId])
}

model StockReservation {
  id             String    @id @default(uuid()) @db.Uuid
  orderItemId    String    @db.Uuid
  lotId          String    @db.Uuid
  unitsReserved  Int       @default(0)
  mlReserved     Int       @default(0)
  status         StockReservationStatus @default(RESERVED)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id])
  lot            InventoryLot @relation(fields: [lotId], references: [id])

  @@unique([orderItemId, lotId])
  @@index([lotId, status])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amountMinor    Int
  providerRef    String?       @unique @db.VarChar(200)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @unique @db.Uuid
  status         ShipmentStatus @default(NOT_SHIPPED)
  courier        String?        @db.VarChar(120)
  trackingNumber String?        @db.VarChar(140)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id])
}

model Review {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  fragranceId  String       @db.Uuid
  rating       Int
  title        String?      @db.VarChar(150)
  body         String?
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id])
  fragrance    Fragrance    @relation(fields: [fragranceId], references: [id])

  @@unique([userId, fragranceId])
  @@index([fragranceId, status])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @db.VarChar(100)
  targetId    String?  @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
}
